{
  "$schema": "./theme.schema.json",
  "id": "ledger",
  "name": "Ledger",
  "description": "Warm paper, ledger green, card faces in the wallet. The default.",
  "options": {
    "navigation": "sidebar",
    "cardArt": "faces",
    "density": "comfortable",
    "motion": "full"
  },
  "type": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace",
    "display": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Helvetica Neue\", sans-serif",
    "scale": 1,
    "displayWeight": 640,
    "displayTracking": -0.03,
    "lineHeight": 1.45
  },
  "shape": {
    "controlRadius": 7,
    "panelRadius": 11,
    "cardRadius": 15,
    "borderWidth": 1
  },
  "spacing": {
    "screen": 28,
    "card": 18,
    "gap": 14
  },
  "motion": {
    "fast": 120,
    "base": 160,
    "easing": "cubic-bezier(.2,0,0,1)"
  },
  "modes": {
    "light": {
      "bg": "#f7f5ef",
      "sidebar": "#efeae0",
      "surface": "#fffdf8",
      "surface2": "#f2eee4",
      "surface3": "#e8e3d6",
      "text": "#161d26",
      "text2": "#3f4a58",
      "muted": "#5f6a78",
      "border": "#e3ddce",
      "borderStrong": "#d3cbb9",
      "borderControl": "#9c917d",
      "accent": "#2c6659",
      "accentInk": "#1f4c42",
      "success": "#2c6659",
      "onAccent": "#f5fbf9",
      "warning": "#8a5c12",
      "danger": "#9c3a2e",
      "focus": "#2a5f8f",
      "chart": [
        "#2c6659",
        "#b26a4c",
        "#5b6c9d",
        "#8a5c12",
        "#7a8f5b"
      ],
      "shadow": "rgb(22 29 38 / 8%)",
