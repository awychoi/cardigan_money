{
  "$schema": "./theme.schema.json",
  "id": "blueprint",
  "name": "Blueprint",
  "description": "Wychoi.com: navy ink, white paper, electric blue action, orange markers.",
  "options": {
    "cardArt": "faces",
    "density": "comfortable",
    "motion": "full",
    "overview": {
      "composition": "ranked-bars",
      "trend": "bars",
      "topCategories": 5,
      "trendMonths": 12
    }
  },
  "type": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, monospace",
    "display": "\"Hoefler Text\", \"Iowan Old Style\", Palatino, ui-serif, Georgia, serif",
    "scale": 1.02,
    "displayWeight": 500,
    "displayTracking": -0.035,
    "lineHeight": 1.55
  },
  "shape": {
    "controlRadius": 2,
    "panelRadius": 3,
    "cardRadius": 6,
    "borderWidth": 1
  },
  "spacing": {
    "screen": 32,
    "card": 20,
    "gap": 16
  },
  "motion": {
    "fast": 160,
    "base": 220,
    "easing": "cubic-bezier(.22, 1, .36, 1)"
